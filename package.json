{
  "name": "ha-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.2.19",
  "scripts": {
    "start": "bunx --bun vite",
    "build": "tsc && bunx --bun vite build",
    "test": "bunx --bun vitest run",
    "coverage": "bunx --bun vitest run --coverage",
    "format": "prettier . --write",
    "lint": "oxlint --type-aware --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "sync-types": "bun sync-types.ts",
    "preview": "bunx --bun vite preview",
    "prebuild": "bun run sync-types",
    "prepare": "husky"
  },
  "dependencies": {
    "@hakit/components": "6.0.2",
    "@hakit/core": "6.0.2",
    "@tanstack/react-query": "5.102.8",
    "clsx": "2.1.1",
    "lottie-react": "3.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "5.7.0",
    "react-router-dom": "7.18.3",
    "react-toastify": "11.1.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@vitest/coverage-v8": "5.0.0",
    "globals": "17.12.0",
    "happy-dom": "20.14.0",
    "husky": "9.1.7",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": "26.2.0"
  }
}
